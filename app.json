{
  "expo": {
    "name": "Sugar Depth",
    "slug": "sugar-hunter",
    "scheme": "reallabel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Sugar Depth",
      "shortName": "Sugar Depth",
      "description": "Scan a food label and see its added sugar and sweeteners. One verdict: Clean, Bad or Ugly.",
      "themeColor": "#06080D",
      "backgroundColor": "#06080D"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Sugar Depth uses the camera to read food and drink labels."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06080D"
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "backgroundColor": "#06080D"
  }
}
