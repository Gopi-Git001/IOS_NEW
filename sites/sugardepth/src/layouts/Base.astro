---
// Type: two latin-only variable fonts defined in styles/fonts.css. The old @fontsource imports
// (Libre Franklin, Newsreader italic, Manrope, Inter Tight) are deliberately stopped, not
// uninstalled; their packages are still in node_modules.
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/crystal.css';
import '../styles/interactive.css';
// Design tokens last so the new palette wins over the generated legacy ones.
import '../styles/design-tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JadeSky from '../components/JadeSky.astro';
import SugarSplash from '../components/SugarSplash.astro';
import { APP_URL, SITE_NAME, abs } from '../config';
import { SCAN_DEEP_LINK } from '../data/app-links';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/how-it-works". Used for the canonical URL. */
  path: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  /**
   * Suppresses the site-wide phone "Scan a label" bar. The home page sets this because its hero
   * renders its own richer quick-actions bar; two sticky bars would stack on top of each other.
   */
  noStickyScan?: boolean;
}
const { title, description, path, ogType = 'website', jsonLd = [], noindex = false, noStickyScan = false } = Astro.props;
const canonical = abs(path);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImage = abs('/og/default.png');
// Phones get a "Scan a label" button that stays at the bottom of the screen. The legal pages do without it.
const stickyScan = !noStickyScan && !['/privacy', '/terms'].includes(path);
// The hero entrance is a homepage-only feature. The pre-paint script needs to know that before
// <body> exists, so it reads these attributes on <html> instead of querying the DOM.
const isHome = path === '/';
const hasSplash = path === '/'; // SugarSplash only renders on the homepage
---
<!doctype html>
<html lang="en" data-intro-home={isHome ? '' : undefined} data-has-splash={hasSplash ? '' : undefined} data-scan-web={APP_URL} data-scan-app={SCAN_DEEP_LINK}>
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-K8262PBN"></script><script is:inline> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('set', { allow_google_signals: false, allow_ad_personalization_signals: false }); gtag('js', new Date());</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <script is:inline data-motion>
      // The intro state, decided before the first paint so the hero is never shown and then hidden.
      // "splash" = first homepage visit in the session, so the opening film plays.
      // "return" = homepage, the splash has already been seen this session, so the hero plays the
      //            short rolling-letters entrance. The hero is hidden from frame one in this state.
      // "none"   = reduced motion, or ?nosplash=1, or a page with no hero to animate.
      // SugarSplash owns the "splash" timeline; HeroVerdictCards owns "return". Nothing else writes it.
      (function () {
        var html = document.documentElement;
        var HAS_SPLASH = html.hasAttribute('data-has-splash');
        var HOME = html.hasAttribute('data-intro-home');
        var reduced = false;
        try {
          reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}
        var skip = /[?&]nosplash=1(?:&|$)/.test(location.search);
        var seen = false;
        try {
          seen = sessionStorage.getItem('sd-splash-seen') === '1';
        } catch (e) {}

        function decide() {
          if (!HOME) return 'none'; // only the homepage has this hero
          if (reduced || skip) return 'none'; // final, no animation
          if (!HAS_SPLASH) return 'return'; // no film on this page: straight to the rolling letters
          return seen ? 'return' : 'splash';
        }

        var state = decide();
        html.setAttribute('data-intro', state);

        // Back/forward: the bfcache restores the DOM as it was, including a finished hero and a
        // completed splash. Re-arm the rolling entrance so the page reads as a load, not a freeze.
        function replay() {
          var s = decide();
          if (s === 'splash') s = 'return'; // never replay the film from cache
          html.setAttribute('data-intro', s);
          if (s === 'return') {
            // Force the entrance to restart from its hidden state.
            html.setAttribute('data-intro', 'none');
            void html.offsetWidth;
            html.setAttribute('data-intro', 'return');
          }
        }
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) replay();
        });
        // Astro view transitions (not enabled today, but harmless): same treatment per navigation.
        document.addEventListener('astro:page-load', replay);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F4F2EB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sugar Depth: read the fine print. Evaporated cane juice? That's sugar." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    {hasSplash && <SugarSplash />}
    <JadeSky fixed />
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {stickyScan && (
      <div class="sticky-scan" data-sticky-scan>
        <a class="btn primary" href={APP_URL}><span class="shutter" aria-hidden="true"></span>Scan a label</a>
      </div>
    )}
    {stickyScan && (
      <script is:inline data-motion>
        // The phone scan bar steps aside while another "Scan a label" button, the try-it form or the footer is on
        // screen, so it never sits on top of them. Without this script it simply stays put (see interactive.css).
        (function () {
          var bar = document.querySelector('[data-sticky-scan]');
          if (!bar || !('IntersectionObserver' in window)) return;
          var onScreen = new Set();
          bar.classList.add('is-away');
          document.documentElement.setAttribute('data-sticky-scan', 'on');
          var watcher = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) onScreen.add(entry.target);
              else onScreen.delete(entry.target);
            });
            bar.classList.toggle('is-away', onScreen.size > 0);
          });
          Array.prototype.forEach.call(document.querySelectorAll('[data-sticky-hide], .site-footer'), function (el) { watcher.observe(el); });
        })();
      </script>
    )}
    <script is:inline data-motion>
      // "Came from the app" mode. The mascot in the phone app opens this site with ?from=app, meaning
      // the visitor already has the app: every "Scan a label" button should go back into it rather than
      // to the web scanner. The flag is kept in sessionStorage, so it lasts for this tab only and a
      // normal visit in a new tab behaves normally. The HTML always carries the https scan URL, so
      // without JavaScript (or before this runs) the links are the ordinary web ones.
      (function () {
        var KEY = 'sd-from-app';
        // The scan URLs come from <html data-scan-web/data-scan-app>, written from the shared
        // brand/app-links.json, so nothing here hardcodes them.
        var html = document.documentElement;
        var WEB_SCAN = html.getAttribute('data-scan-web');
        var APP_SCAN = html.getAttribute('data-scan-app');
        if (!WEB_SCAN || !APP_SCAN) return;
        var params = new URLSearchParams(location.search);
        if (params.get('from') === 'app') {
          try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
          // Drop the parameter so the visible address, and a later reload, look like a normal visit.
          params.delete('from');
          var qs = params.toString();
          history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
        }
        var fromApp = false;
        try { fromApp = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
        if (!fromApp) return;
        document.documentElement.setAttribute('data-from-app', 'on');
        function upgrade() {
          Array.prototype.forEach.call(document.querySelectorAll('a[href="' + WEB_SCAN + '"]'), function (a) {
            a.setAttribute('href', APP_SCAN);
            a.setAttribute('data-from-app', 'true');
          });
        }
        upgrade();
        document.addEventListener('astro:page-load', upgrade);
      })();
    </script>
  </body>
</html>
