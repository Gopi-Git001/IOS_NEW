---
import '@fontsource/libre-franklin/latin-400.css';
import '@fontsource/libre-franklin/latin-600.css';
import '@fontsource/libre-franklin/latin-800.css';
import '@fontsource/libre-franklin/latin-900.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '../styles/global.css';
import '../styles/crystal.css';
import '../styles/interactive.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { APP_URL, SITE_NAME, abs } from '../config';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/how-it-works". Used for the canonical URL. */
  path: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, path, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const canonical = abs(path);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImage = abs('/og/default.png');
// Phones get a "Scan a label" button that stays at the bottom of the screen. The legal pages do without it.
const stickyScan = !['/privacy', '/terms'].includes(path);
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-K8262PBN"></script><script is:inline> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date());</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F4F2EB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sugar Depth: read the fine print. Evaporated cane juice? That's sugar." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {stickyScan && (
      <div class="sticky-scan" data-sticky-scan>
        <a class="btn primary" href={APP_URL}><span class="shutter" aria-hidden="true"></span>Scan a label</a>
      </div>
    )}
    {stickyScan && (
      <script is:inline data-motion>
        // The phone scan bar steps aside while another "Scan a label" button, the try-it form or the footer is on
        // screen, so it never sits on top of them. Without this script it simply stays put (see interactive.css).
        (function () {
          var bar = document.querySelector('[data-sticky-scan]');
          if (!bar || !('IntersectionObserver' in window)) return;
          var onScreen = new Set();
          bar.classList.add('is-away');
          document.documentElement.setAttribute('data-sticky-scan', 'on');
          var watcher = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) onScreen.add(entry.target);
              else onScreen.delete(entry.target);
            });
            bar.classList.toggle('is-away', onScreen.size > 0);
          });
          Array.prototype.forEach.call(document.querySelectorAll('[data-sticky-hide], .site-footer'), function (el) { watcher.observe(el); });
        })();
      </script>
    )}
  </body>
</html>
