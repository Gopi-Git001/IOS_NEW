---
interface Props {
  name: 'label' | 'aliases' | 'slabs' | 'specimen';
  alt: string;
  sizes?: string;
}
const { name, alt, sizes = '(max-width: 760px) calc(100vw - 40px), 1200px' } = Astro.props;
const dimensions = { label: [1600, 1063], aliases: [1600, 1063], slabs: [1600, 686], specimen: [1600, 905] };
const [width, height] = dimensions[name];
const base = `/media/crystal-${name}`;
---
<picture class="editorial-image">
  <source type="image/avif" srcset={`${base}-800.avif 800w, ${base}-1600.avif 1600w`} sizes={sizes} />
  <source type="image/webp" srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`} sizes={sizes} />
  <img src={`${base}-800.webp`} srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`} sizes={sizes} {width} {height} {alt} loading="lazy" decoding="async" />
</picture>
