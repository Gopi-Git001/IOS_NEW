---
import { toneClass } from '../data/ingredients';
// rules-v3 verdict words. The colour classes keep their older names: amber is `tone-bad`, red is `tone-ugly`.
const WORDS = ['CLEAN', 'OKAY', 'BAD'] as const;
// `compact` is the glass slab on its own, with no display type beside it (the home hero).
interface Props { verdict?: (typeof WORDS)[number]; interactive?: boolean; compact?: boolean; }
const { verdict = 'BAD', interactive = false, compact = false } = Astro.props;
---
<div class:list={['crystal-stage', `tone-${toneClass(verdict)}`, { 'crystal-compact': compact }]} data-crystal>
  {interactive && WORDS.map(word => <input class="crystal-choice" type="radio" name="preview-verdict" id={`preview-${word}`} value={word} checked={word === verdict} aria-label={`Show the ${word} slab`} />)}
  {!compact && <div class="crystal-type">
    <span class="crystal-eyebrow">Sugar Depth · Verdicts</span>
    <div class="crystal-wordline">
      {interactive ? WORDS.map(word => <span class={`crystal-word preview-${word}`} data-reflection={word}>{word}</span>) : <span class="crystal-word" data-reflection={verdict}>{verdict}</span>}
      <span class="crystal-bead" aria-hidden="true"></span>
    </div>
    <div class="crystal-signoff">Three verdicts. The worst ingredient decides.</div>
  </div>}
  <div class="crystal-object" aria-hidden="true">
    <div class="crystal-caustic"></div>
    <div class="crystal-slab">
      <span class="crystal-slab-label">Verdict</span>
      {interactive ? WORDS.map(word => <span class={`crystal-slab-word preview-${word}`}>{word}</span>) : <span class="crystal-slab-word">{verdict}</span>}
      <span class="crystal-glint"></span>
    </div>
  </div>
  {interactive && <div class="crystal-controls">
    {WORDS.map(word => <label for={`preview-${word}`}><span class={`crystal-dot tone-${toneClass(word)}`}></span>{word}</label>)}
  </div>}
</div>
