    // NOTE: the first scheduleNext() runs once the cards have landed (see the end of this script),
    // so the deck does not cycle behind the opening film. CLEAN is in front until then.

    /**
     * Bring card `idx` to the front immediately, continuing from whatever is there now so the
     * remaining two keep their relative order (no jump back to CLEAN).
     * Cancels any in-flight fly-out so repeated switches cannot stack or jump.
     */
    function show(idx, announce) {
      if (order[0] === idx) {
        // Already in front: still settle any fly-out and refresh the announcement.
        generation += 1;
        leaving = false;
        cards.forEach(function (c) {
          c.removeAttribute('data-leaving');
        });
        paint(announce);
        return;
      }
      // Invalidate the pending fly-out and clear its leaving state.
      generation += 1;
      leaving = false;
      cards.forEach(function (c) {
        c.removeAttribute('data-leaving');
      });
