<script is:inline data-motion>
  // Card cycle, verdict buttons, glow and the entrance. Pure DOM; no framework.
  (function () {
    var hero = document.querySelector('[data-hero-paper]');
    if (!hero) return;

    var cards = [].slice.call(hero.querySelectorAll('[data-vcard]'));
    var buttons = [].slice.call(hero.querySelectorAll('[data-verdict-btn]'));
    var glow = hero.querySelector('[data-hero-glow]');
    var live = hero.querySelector('[data-hero-live]');
    if (!cards.length) return;

    var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // All interaction timings live here.
    var TIMING = {
      cycleEvery: 2600, // automatic cycle period
      hoverDelay: 80, // debounce so sweeping across buttons shows only the last
      resumeAfterHover: 2000, // after the pointer leaves both buttons and cards
      resumeAfterTap: 6000, // after a tap / click / keypress
      leaveMs: 420, // a card's fly-out before it re-enters at the back
    };

    // order[0] is the front card, order[1] second, order[2] third.
    var order = [0, 1, 2];
    var paused = false;
    var holdUntil = 0;
    var leaving = false;
    // Bumped whenever something external reorders the deck. A cycle that was mid-flight when the
    // user acted checks this and stands down, so its pending timer cannot overwrite their choice.
    var generation = 0;
    // Pending debounce timers, so a sweep across buttons only applies the last one.
    var hoverTimer = 0;
    var resumeTimer = 0;

    // `announce` is true only for tap / click / keyboard, never for hover.
    function paint(announce) {
      cards.forEach(function (card, i) {
        var pos = order.indexOf(i);
        card.removeAttribute('data-leaving');
        card.setAttribute('data-pos', String(pos));
        // Only the front card is exposed to assistive tech.
        card.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
      });
      // Glow follows the front card's colour.
      var front = cards[order[0]];
      if (front && glow) {
        glow.style.setProperty('--glow', front.getAttribute('data-dot'));
      }
      // Buttons mirror the front card.
      buttons.forEach(function (btn, i) {
        btn.setAttribute('aria-pressed', i === order[0] ? 'true' : 'false');
      });
      if (live && announce) {
        var f = cards[order[0]];
        if (f) {
          var word = f.querySelector('.vcard-word').textContent.trim();
          var reason = f.querySelector('.vcard-reason').textContent.trim();
          var product = f.querySelector('.vcard-chip').textContent.trim();
          live.textContent = 'Showing ' + word + ': ' + product + ', ' + reason + '.';
        }
      }
    }

    function advance() {
      if (leaving) return;
      leaving = true;
      var mine = generation;
      var frontIdx = order[0];
      var front = cards[frontIdx];
      front.setAttribute('data-leaving', 'true');
      window.setTimeout(function () {
        // The user acted while this card was flying out: drop this cycle's result entirely.
        if (mine !== generation) {
          leaving = false;
          return;
        }
        // Move the front card to the back.
        order = [order[1], order[2], order[0]];
        front.removeAttribute('data-leaving');
        paint(false);
        leaving = false;
      }, TIMING.leaveMs);
    }

    function cycleRunning() {
      return !REDUCED && !paused && Date.now() >= holdUntil;
    }

    // A self-rescheduling timer rather than setInterval: after a pause the next card must advance
    // when the pause expires, not whenever a fixed interval happens to come round (which made the
    // first post-hover change land up to a whole cycle late).
    var cycleTimer = 0;
    function scheduleNext(ms) {
      window.clearTimeout(cycleTimer);
      if (REDUCED) return;
      cycleTimer = window.setTimeout(function () {
        if (cycleRunning()) advance();
        scheduleNext(TIMING.cycleEvery);
      }, ms);
