    // Debounced by hoverDelay so sweeping the cursor across all three only shows the last.
    function queueShow(idx) {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(function () {
        show(idx, false);
      }, TIMING.hoverDelay);
    }

    function pauseNow() {
      paused = true;
      window.clearTimeout(resumeTimer);
    }
    // Resume after a quiet period, continuing from whichever card is in front. The next advance is
    // scheduled for exactly the end of that quiet period, so the cycle restarts on time instead of
    // waiting for a fixed interval that may already be half spent.
    function resumeLater(ms) {
      window.clearTimeout(resumeTimer);
      paused = false;
      holdUntil = Date.now() + ms;
      scheduleNext(ms);
