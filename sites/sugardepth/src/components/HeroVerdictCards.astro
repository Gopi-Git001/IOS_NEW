      function buttonAt(x, y) {
        var el = document.elementFromPoint(x, y);
        var btn = el && el.closest ? el.closest('[data-verdict-btn]') : null;
        return btn ? Number(btn.getAttribute('data-index')) : -1;
      }

      btnRow.addEventListener('pointerdown', function (event) {
