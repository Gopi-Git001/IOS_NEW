        var next = event.relatedTarget;
        if (next && next.closest && next.closest('[data-verdict-btns]')) return;
        hoveringButtons = false;
        // Let the card the pointer is still over claim the pause before we release it.
        window.setTimeout(function () {
          if (!hoveringCards) resumeLater(TIMING.resumeAfterHover);
        }, 0);
      });

      // Keyboard focus behaves like hover.
      btn.addEventListener('focus', function () {
        pauseNow();
        queueShow(idx);
      });

      // Click (mouse) and tap (touch) are the deliberate actions: announce them.
      btn.addEventListener('click', function () {
        window.clearTimeout(resumeTimer);
        window.clearTimeout(hoverTimer);
        show(idx, true);
        resumeLater(TIMING.resumeAfterTap);
      });

      // Arrow keys move between the three buttons.
      btn.addEventListener('keydown', function (event) {
        var delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        var next = buttons[(idx + delta + buttons.length) % buttons.length];
        if (next) next.focus();
      });
    });

    // Leaving the button row resumes the cycle from the card in front.
    if (btnRow) {
      btnRow.addEventListener('pointerleave', function () {
        hoveringButtons = false;
        // Let the card the pointer is still over claim the pause before we release it.
        window.setTimeout(function () {
          if (!hoveringCards) resumeLater(TIMING.resumeAfterHover);
        }, 0);
      });
    }

