        queueShow(dragIndex);
      });

      btnRow.addEventListener('pointermove', function (event) {
        if (dragIndex < 0) return;
        var under = buttonAt(event.clientX, event.clientY);
        if (under < 0 || under === dragIndex) return;
        dragIndex = under;
        queueShow(under);
      });

      var endDrag = function () {
        if (dragIndex < 0) return;
        dragIndex = -1;
        resumeLater(TIMING.resumeAfterTap);
      };
      btnRow.addEventListener('pointerup', endDrag);
      btnRow.addEventListener('pointercancel', endDrag);
    }

    // ---------- the card stack pauses the cycle too ----------
    var stage = hero.querySelector('[data-hero-stage]');
    if (stage) {
      stage.addEventListener('pointerenter', function () {
        hoveringCards = true;
        pauseNow();
      });
      stage.addEventListener('pointerleave', function () {
        hoveringCards = false;
        if (!hoveringButtons) resumeLater(TIMING.resumeAfterHover);
      });
    }

    if (btnRow) {
      btnRow.addEventListener('pointerenter', function () {
        hoveringButtons = true;
      });
    }

    paint(false);


    // Entrance is CSS-owned: <html data-intro> is the single source of truth, set before the first
    // paint and advanced by SugarSplash along the shared timeline. The hero only reveals the
    // quick-actions bar when the intro is over, and starts its card cycle once the cards land.
    function showBar() {
      var bar = document.querySelector('[data-paper-bar]');
      if (!bar || REDUCED) {
        if (bar) {
          bar.hidden = false;
          bar.setAttribute('data-shown', 'true');
        }
        return;
      }
      bar.hidden = false;
      // Two frames: one to commit the hidden -> layout state, one to trigger the transition.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          bar.setAttribute('data-shown', 'true');
        });
      });
    }
    // The hero obeys <html data-intro>; it never decides its own entrance. It only needs to know
    // when the entrance has finished, to reveal the quick-actions bar, and when the cards have
    // landed, to start the card cycle from CLEAN.
    function introSeconds(name, fallback) {
      var raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      var n = parseFloat(raw);
      return isNaN(n) ? fallback : n * (raw.indexOf('ms') > -1 ? 0.001 : 1);
    }
    var htmlEl = document.documentElement;
    var INTRO = htmlEl.getAttribute('data-intro');
    // Two entrances, one timeline source. "splash" waits for the film (SugarSplash advances the
    // attribute); "return" rolls in immediately. Either way the hero ends by setting "done".
    var NO_ENTRANCE = INTRO === 'none' || INTRO === 'done';
    var IS_RETURN = INTRO === 'return';

    // When the cards land, measured from load for "return" and from the hero start for "splash".
    var CARDS_LAND_MS = Math.round(
      IS_RETURN
        ? (introSeconds('--ret-cards-delay', 0.7) + introSeconds('--ret-cards-dur', 0.8)) * 1000
        : (introSeconds('--intro-hero-start', 2.6) +
            introSeconds('--intro-cards-delay', 0.4) +
            introSeconds('--intro-cards-dur', 0.8)) *
            1000,
    );
    var CYCLE_DELAY_MS = Math.round(introSeconds('--intro-cycle-delay', 1.2) * 1000);
    var CYCLE_START_MS = NO_ENTRANCE ? CYCLE_DELAY_MS : CARDS_LAND_MS + CYCLE_DELAY_MS;
    // When the last thing to finish actually finishes — the settled "done" state is only applied
    // after that, or it would cut a running animation short (the highlighter sweeps to 1.76s).
    var ENTRANCE_END_MS = Math.round(
      (IS_RETURN
        ? Math.max(
            introSeconds('--ret-cards-delay', 0.7) + introSeconds('--ret-cards-dur', 0.8),
            introSeconds('--ret-mark-delay', 1.41) + introSeconds('--ret-mark-dur', 0.35),
            introSeconds('--ret-line-3-delay', 0.56) + 14 * introSeconds('--ret-letter-step', 0.025) + introSeconds('--ret-letter-dur', 0.5),
          )
        : introSeconds('--intro-hero-start', 2.6) +
          Math.max(
            introSeconds('--intro-cards-delay', 0.4) + introSeconds('--intro-cards-dur', 0.8),
            introSeconds('--intro-mark-delay', 0.84) + introSeconds('--intro-mark-dur', 0.35),
          )) * 1000,
    );
    var INTRO_END_MS = ENTRANCE_END_MS + 120;

    function afterIntro(fn) {
      if (NO_ENTRANCE || htmlEl.getAttribute('data-intro') === 'done') {
        fn();
        return;
      }
      var obs = new MutationObserver(function () {
        if (htmlEl.getAttribute('data-intro') === 'done') {
          obs.disconnect();
          fn();
        }
      });
      obs.observe(htmlEl, { attributes: true, attributeFilter: ['data-intro'] });
      // Belt and braces: never leave the bar hidden if the observer cannot fire.
      window.setTimeout(function () {
        if (htmlEl.getAttribute('data-intro') !== 'done') {
          obs.disconnect();
          fn();
        }
      }, INTRO_END_MS + 2000);
    }

    // The return entrance has no splash to advance the state, so the hero closes it itself once the
    // cards have landed. "done" is the settled state and matches the end keyframes exactly.
    if (IS_RETURN) {
      window.setTimeout(function () {
        if (htmlEl.getAttribute('data-intro') === 'return') htmlEl.setAttribute('data-intro', 'done');
      }, INTRO_END_MS + 60);
    }

    // Back/forward restores the page from cache with "return" set again; restart the entrance.
    window.addEventListener('pageshow', function (event) {
      if (event.persisted) restartReturn();
    });
    function restartReturn() {
      if (htmlEl.getAttribute('data-intro') !== 'return') return;
      window.setTimeout(function () {
        if (htmlEl.getAttribute('data-intro') === 'return') htmlEl.setAttribute('data-intro', 'done');
      }, INTRO_END_MS + 60);
    }

    afterIntro(showBar);
    // Start cycling when the cards land. scheduleNext takes the delay until the NEXT advance, so
    // pass 0 and let it re-arm itself after that.
    window.setTimeout(function () {
      scheduleNext(0);
    }, CYCLE_START_MS);

    // Desktop: a hovered letter is knocked down and springs back. One-shot on pointerenter.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      var h1El = document.querySelector('[data-rise]');
      if (h1El) {
        h1El.addEventListener('pointerover', function (event) {
          var t = event.target;
          if (!t.classList || !t.classList.contains('paper-letter')) return;
          t.removeAttribute('data-knock');
          void t.offsetWidth; // restart the animation
          t.setAttribute('data-knock', 'true');
        });
      }
    }
  })();
</script>
