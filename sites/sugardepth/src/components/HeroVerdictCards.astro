---
// HeroVerdictCards — "Option C: Sugar paper". Light sugar-paper background with a faint 48px
// grid, mission copy on the left, and three tilted verdict cards on the right that cycle
// CLEAN -> OKAY -> BAD. Cards are built in CSS, never images.
//
// The h1 and every string are server-rendered, so the headline is in the HTML before JS runs.
// Motion is a plain data-motion script (this site's build check allows no other inline scripts).
import { APP_URL } from '../config';

interface Props {
  /** Which hero to show. "paper" is this one; "classic" keeps the dark crystal hero. */
  variant?: 'paper' | 'classic';
}

const { variant = 'paper' } = Astro.props;

/**
 * Sample products, not real labels. Edit this array to change the cards: order is the cycle
 * order (index 0 starts in front), and each entry drives the card, its glow and its button.
 */
const VERDICTS = [
  {
    word: 'CLEAN',
    product: 'Greek yogurt',
    reason: 'No added sugar',
    from: '#3DBB78',
    via: '#1C8E52',
    to: '#127443',
    edge: '#0D5A33',
    dot: '#3DCB7F',
  },
  {
    word: 'OKAY',
    product: 'Protein bar',
    reason: '1 g added · erythritol',
    from: '#ECB955',
    via: '#C98E2A',
    to: '#9E6A16',
    edge: '#7A4E0C',
    dot: '#F2B33D',
  },
  {
    word: 'BAD',
    product: 'Cola',
    reason: '39 g added sugar',
    from: '#EE6355',
    via: '#C93A31',
    to: '#A12922',
    edge: '#771B16',
    dot: '#F0635A',
  },
] as const;

const EYEBROW = 'OUR MISSION';
const SUBTEXT =
  'We read the fine print on every food label and name each added sugar and sweetener. What you eat is your call.';
const DISCLAIMER = 'A food-label scanner. Not medical advice; no allergen checks.';

// Splitting the headline into per-letter spans lets each letter rise on its own beat. Words are
// grouped so a line can only break between words, never inside one. A visually hidden copy gives
// screen readers the plain sentence.
const HEAD_TEXT = 'Sugar has a lot of aliases. We read every one.';
const toWords = (text: string) =>
  text.split(' ').map((w) => ({ letters: [...w] }));
// Three explicit lines, each in its own overflow mask, so the entrance can stagger them. The
// breaks match what the text already wrapped to ("Sugar has a" / "lot of aliases." / "We read
// every one.") at every width tested, so nothing re-wraps; each line is short enough to fit.
const HEAD_LINES = [toWords('Sugar has a'), toWords('lot of aliases.'), toWords('We read every one.')];
const HEAD_WORDS_2 = HEAD_LINES[2];
---

<section class="paper-hero" data-hero-paper data-variant={variant} aria-labelledby="paper-hero-h">
  <div class="paper-grid" aria-hidden="true"></div>
  <div class="paper-fade" aria-hidden="true"></div>

  <div class="paper-inner">
    <div class="paper-copy">
      <p class="paper-badge" data-hero-item>
        <span class="paper-badge-dot" aria-hidden="true"></span>
        {EYEBROW}
      </p>

      <h1 id="paper-hero-h" class="paper-h1" data-hero-item>
        <!-- Three lines, each its own overflow mask. Words are nowrap spans so a line can never
             re-wrap mid-animation. Each letter carries --i (its index within the line) for the
             rolling stagger. A visually hidden copy gives screen readers the plain sentence. -->
        <span class="sr-only">{HEAD_TEXT}</span>
        {HEAD_LINES.map((words, li) => {
          // Letters are numbered across the whole line, so the stagger continues word to word
          // instead of restarting at every word.
          let n = 0;
          return (
            <span class={`paper-line${li === 2 ? ' paper-line--last' : ''}`} data-line={li + 1} aria-hidden="true">
              <span class="paper-rise" style={`--ret-line-start: var(--ret-line-${li + 1}-delay)`}>
                <span class={li === 2 ? 'paper-mark' : undefined}>
                  {words.map((word, wi) => (
                    <>
                      {wi > 0 ? ' ' : ''}
                      <span class="paper-word">
                        {word.letters.map((c) => {
                          const idx = n++;
                          return (
                            <span class="paper-letter" style={`--i: ${idx}`}>
                              {c}
                            </span>
                          );
                        })}
                      </span>
                    </>
                  ))}
                </span>
              </span>
            </span>
          );
        })}
      </h1>

      <p class="paper-sub" data-hero-item>{SUBTEXT}</p>

      <p class="paper-note" data-hero-note>{DISCLAIMER}</p>

      <div class="paper-ctas" data-hero-item>
        <a class="paper-btn paper-btn--primary" href={APP_URL}>
          <span class="paper-dot" aria-hidden="true"></span>
          Scan a label
          <span class="paper-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            </svg>
          </span>
        </a>
        <a class="paper-btn paper-btn--ghost" href="/how-it-works">How verdicts work</a>
      </div>
    </div>

    <div class="paper-cards">
      <div class="paper-glow" data-hero-glow aria-hidden="true"></div>

      <div class="paper-stage" data-hero-stage>
        {VERDICTS.map((v, i) => (
          <article
            class="vcard"
            data-vcard
            data-index={i}
            data-dot={v.dot}
            {/* data-pos is rendered here, not just set by the script, so the resting positions and
                stacking order are already correct before any JS runs: CLEAN is in front. Without it
                all three cards sit at the same spot and the last one (BAD) paints on top, which is
                what a visitor with scripting disabled would see. */}
            data-pos={i}
            aria-hidden={i === 0 ? 'false' : 'true'}
            style={`--c-from:${v.from};--c-via:${v.via};--c-to:${v.to};--c-edge:${v.edge};--c-dot:${v.dot}`}
          >
            <span class="vcard-gloss" aria-hidden="true"></span>
            <div class="vcard-top">
              <span class="vcard-kicker">Verdict</span>
              <span class="vcard-chip">{v.product}</span>
            </div>
            <div class="vcard-bottom">
              <p class="vcard-word">{v.word}</p>
              <p class="vcard-reason">{v.reason}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="paper-verdicts" data-verdict-btns role="group" aria-label="Show a verdict">
        {VERDICTS.map((v, i) => (
          <button
            type="button"
            class="paper-verdict"
            data-verdict-btn
            data-index={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="paper-verdict-dot" aria-hidden="true" style={`--c-dot:${v.dot}`}></span>
            {v.word}
          </button>
        ))}
      </div>

      <p class="paper-live" data-hero-live aria-live="polite">Showing CLEAN: Greek yogurt, no added sugar.</p>
    </div>
  </div>
</section>

<!--
  Phone quick actions. Sits above the page but below the header (z 30) and the glass menu (z 24+),
  and hides while the menu is open or the hero entrance has not finished yet.
-->
<nav class="paper-bar" data-paper-bar aria-label="Quick actions" hidden>
  <a class="paper-bar-ghost" href="/how-it-works">How it works</a>
  <a class="paper-bar-primary" href={APP_URL}>
    <span class="paper-dot" aria-hidden="true"></span>
    Scan a label
  </a>
</nav>

<style>
  /* ---------- sugar paper ---------- */
  /* Spacing is owned here, not inherited. global.css gives every <section> a
     clamp(56px, 8vw, 104px) block padding and .paper-inner adds its own; stacked they produced a
     200px gap under the header at 1440px. Zero the inherited padding and add the intended one. */
  .paper-hero {
    --paper-bg: #f2f7f3;
    --paper-ink: #121614;
    --paper-muted: #4a5650;
    --paper-accent: #13804b;
    --paper-line: rgba(18, 22, 20, 0.25);

    /* Gap under the header, per breakpoint: 28px phones, 36px tablets, 40-64px laptops. */
    --hero-gap-top: 28px;
    --hero-pad-bottom: 40px;

    padding-block: 0;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--paper-bg);
    color: var(--paper-ink);
  }

  /* 48px squares, then a vertical fade so the grid reads faint at the edges. */
  .paper-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(18, 22, 20, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(18, 22, 20, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .paper-fade {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      #f2f7f3 0%,
      rgba(242, 247, 243, 0.6) 50%,
      #f2f7f3 100%
    );
  }

  .paper-inner {
    position: relative;
    z-index: 1;
    /* The same container as .wrap, so the hero text lines up with every other section. */
    inline-size: 100%;
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-block: var(--hero-gap-top) var(--hero-pad-bottom);
    padding-inline: var(--container-pad);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 48px;
    /* No vertical centring: the columns start at the top of the hero. */
    align-items: start;
  }

  /* ---------- text column ---------- */
  .paper-copy {
    flex: 1 1 440px;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  /* The eyebrow is a pill badge: dot + "Our mission". */
  .paper-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin: 0 0 4px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #ddf3e6;
    color: #0f6b3e;
    font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .paper-badge-dot {
    inline-size: 6px;
    block-size: 6px;
    flex: none;
    border-radius: 50%;
    background: #13804b;
  }
  /* Two sentences, each its own block, so the wrap count is the browser's choice, not a <br>.
     The second sentence must not wrap internally: at the top of the size clamp it is a few pixels
     wider than the text column, and breaking it yields a one-word last line. Holding it whole keeps
     the headline at three lines across the whole range. */
  .paper-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 1.2rem + 3.6vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  /* Laptops: a slightly wider text column and a smaller cap keep the second sentence on one line
     without forcing it (no text-wrap: nowrap). The two columns share the row with the 48px gap, so
     their bases must total less than 100% — 56% + 44% + 48px overflowed and pushed the cards onto
     a second row at exactly 1024px. calc() subtracts half the gap from each side. */
  @media (min-width: 1024px) {
    .paper-copy {
      flex: 0 0 calc(56% - 24px);
      max-inline-size: calc(56% - 24px);
    }
    .paper-cards {
      flex: 0 0 calc(44% - 24px);
      max-inline-size: calc(44% - 24px);
    }
    .paper-h1 {
      font-size: clamp(34px, 1.2rem + 3.4vw, 64px);
    }
  }
  .paper-line {
    display: block;
    text-wrap: balance;
    /* A mask so each letter can rise from below the line without spilling over its neighbour.
       The bottom padding keeps descenders ("y", "g") inside the mask instead of being clipped —
       line-height alone is not enough, because the mask clips to the padding box. */
    overflow: hidden;
    padding-block-end: 0.14em;
    margin-block-end: -0.14em;
  }
  .paper-line--last {
    margin-block-start: 2px;
  }
  /* The stagger container; letters translate inside it. */
  .paper-rise {
    display: inline-block;
  }
  /* A word never breaks internally: this is what keeps "lot" whole. */
  .paper-word {
    display: inline-block;
    white-space: nowrap;
  }
  .paper-letter {
    display: inline-block;
    will-change: transform;
  }
  /* Desktop only: a letter knocked down by the pointer springs back. */
  @media (hover: hover) and (pointer: fine) {
    .paper-letter[data-knock='true'] {
      animation: paper-knock 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes paper-knock {
      0% {
        transform: translateY(0) scale(1);
      }
      18% {
        transform: translateY(0.07em) scale(1.04, 0.9);
      }
      100% {
        transform: translateY(0) scale(1);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* The per-line rise is the intro's; with reduced motion there is no intro at all. */
    .paper-line .paper-rise {
      transform: none;
      animation: none;
    }
  }
  /* Highlighter behind the second sentence: a marker stripe, not a colour change.
     It is a background-image whose size the intro sweeps from 0% to 100%, so the bar can only
     appear once its words have landed. */
  .paper-mark {
    padding: 0 4px;
    margin: 0 -4px;
    background-image: linear-gradient(
      transparent 56%,
      #bdefd2 56%,
      #bdefd2 90%,
      transparent 90%
    );
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: 100% 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .paper-sub {
    margin: 0;
    max-inline-size: 46ch;
    font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--paper-muted);
    text-wrap: pretty;
  }

  /* ---------- buttons ---------- */
  .paper-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px;
    align-items: center;
  }
  .paper-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    block-size: 54px;
    padding: 0 26px;
    border-radius: 999px;
    font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s var(--ease-out), background 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }
  .paper-btn--primary {
    background: #121614;
    color: #fff;
    box-shadow: 0 14px 28px -16px rgba(18, 22, 20, 0.7);
  }
  .paper-btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 32px -16px rgba(18, 22, 20, 0.8);
  }
  .paper-btn--ghost {
    background: transparent;
    color: var(--paper-ink);
    border: 1px solid var(--paper-line);
  }
  .paper-btn--ghost:hover {
    background: rgba(18, 22, 20, 0.05);
  }
  .paper-btn:focus-visible {
    outline: 2px solid var(--paper-ink);
    outline-offset: 3px;
  }
  .paper-dot {
    inline-size: 14px;
    block-size: 14px;
    flex: none;
    border-radius: 50%;
    border: 2px solid currentColor;
    box-shadow: inset 0 0 0 2.5px #121614, inset 0 0 0 8px currentColor;
  }
  .paper-arrow svg {
    inline-size: 17px;
    block-size: 17px;
    display: block;
  }
  .paper-note {
  margin: 0;
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.5;
  color: var(--muted);
  }

  /* ---------- cards column ---------- */
  .paper-cards {
    position: relative;
    flex: 1 1 420px;
    min-inline-size: 0;
    /* Centred against the text block itself, not against the viewport. */
    align-self: center;
  }
  /* A soft pool of the front card's colour, behind the stack. */
  .paper-glow {
    position: absolute;
    inset-block-start: 8%;
    inset-inline-end: -6%;
    inline-size: 60%;
    aspect-ratio: 1;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--glow, #3dbb78) 16%, transparent) 0%,
      transparent 65%
    );
    transition: background 0.6s var(--ease-out);
  }

  .paper-stage {
    position: relative;
    z-index: 1;
    block-size: clamp(330px, 32vw, 470px);
  }

  /* ---------- a single card ---------- */
  .vcard {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: clamp(200px, 21vw, 290px);
    aspect-ratio: 10 / 13;
    padding: 20px 20px 22px;
    border-radius: 26px;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: linear-gradient(160deg, var(--c-from) 0%, var(--c-via) 55%, var(--c-to) 100%);
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.32),
      inset 0 2px 0 rgba(255, 255, 255, 0.45),
      0 10px 0 var(--c-edge),
      0 34px 60px -22px rgba(0, 0, 0, 0.65);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease;
    will-change: transform, opacity;
    font-family: var(--font-body);
  }
  /* The diagonal gloss that makes the card read as glass. */
  .vcard-gloss {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      transparent 30%,
      rgba(255, 255, 255, 0.32) 42%,
      transparent 54%
    );
  }
  .vcard-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .vcard-kicker {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.92;
  }
  .vcard-chip {
    max-inline-size: 62%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.22);
    font-size: 11px;
    font-weight: 600;
  }
  .vcard-bottom {
    position: relative;
  }
  .vcard-word {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(44px, 4.6vw, 66px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.18);
  }
  .vcard-reason {
    margin: 10px 0 0;
    font-size: 14px;
    font-weight: 600;
    opacity: 0.95;
  }

  /* ---------- the three resting positions ---------- */
  .vcard[data-pos='0'] {
    transform: translate(-86%, -50%) rotate(-6deg) scale(1);
    z-index: 3;
    opacity: 1;
  }
  .vcard[data-pos='1'] {
    transform: translate(-44%, -53%) rotate(7deg) scale(0.95);
    z-index: 2;
    opacity: 1;
  }
  .vcard[data-pos='2'] {
    transform: translate(-8%, -56%) rotate(15deg) scale(0.9);
    z-index: 1;
    opacity: 0.85;
  }
  /* Leaving: the front card swings out to the left before it re-enters at the back. */
  .vcard[data-leaving='true'] {
    transform: translate(-150%, -44%) rotate(-20deg) scale(0.94);
    opacity: 0;
    z-index: 4;
  }

  /* ---------- verdict buttons ---------- */
  .paper-verdicts {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-start: 18px;
    /* A finger sliding along the row must not be mistaken for a page scroll (and vice versa). */
    touch-action: pan-y;
  }
  .paper-verdict {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    block-size: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(18, 22, 20, 0.16);
    background: transparent;
    color: #2c3531;
    font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  .paper-verdict[aria-pressed='true'] {
    background: #121614;
    color: #fff;
    border-color: #121614;
  }
  .paper-verdict:focus-visible {
    outline: 2px solid var(--paper-ink);
    outline-offset: 3px;
  }
  .paper-verdict-dot {
    inline-size: 9px;
    block-size: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--c-dot);
  }

  /* Announced politely; not visible. */
  .paper-live {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- breakpoint spacing: 28px phones, 36px tablets, 40-64px laptops ---------- */
  @media (min-width: 768px) {
    .paper-hero {
      --hero-gap-top: 36px;
    }
  }
  @media (min-width: 1024px) {
    .paper-hero {
      --hero-gap-top: clamp(40px, 4vw, 64px);
      --hero-pad-bottom: 64px;
    }
  }

  /* ---------- under 1024px: one column, max 560px, phone layout ---------- */
  @media (max-width: 1023.98px) {
    .paper-hero .paper-grid {
      background-size: 40px 40px;
      background-image:
        linear-gradient(to right, rgba(18, 22, 20, 0.055) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(18, 22, 20, 0.055) 1px, transparent 1px);
    }
    .paper-hero .paper-fade {
      background: linear-gradient(
        180deg,
        #f2f7f3 0%,
        rgba(242, 247, 243, 0.55) 50%,
        #f2f7f3 100%
      );
    }
    .paper-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      /* Same container width and padding as .wrap on phones: no separate 560px column, which
         would pull the hero text out of line with "Three steps". */
      max-inline-size: none;
      padding-block: var(--hero-gap-top) var(--hero-pad-bottom);
      padding-inline: var(--container-pad);
    }
    .paper-copy,
    .paper-cards {
      flex: 1 1 auto;
    }
    /* Stacked on phones, so the cards are no longer a side column to centre. */
    .paper-cards {
      align-self: stretch;
    }
    /* The tight 14px rhythm between eyebrow, headline and subtext. */
    .paper-copy {
      gap: 14px;
      text-align: left;
    }
    .paper-badge {
      margin-block-end: 0;
    }
    .paper-h1 {
      font-size: 34px;
    }
    .paper-sub {
      max-inline-size: 34ch;
