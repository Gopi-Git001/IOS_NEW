---
import { APP_URL } from '../config';
import LiquidGlassButton from './LiquidGlassButton.astro';
import MenuPanel from './MenuPanel.astro';
const { path } = Astro.props as { path: string };
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/ingredients', label: 'Ingredients' },
  { href: '/hidden-sugar-names', label: 'Hidden sugar names' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => (href === '/ingredients' ? path.startsWith('/ingredients') : path === href);
---
<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="Sugar Depth home"><span>Sugar Depth</span></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <LiquidGlassButton class="header-cta" href={APP_URL} size="sm" icon>Scan a label</LiquidGlassButton>
    <details class="nav-menu">
      <summary class="nav-menu-button" aria-controls="phone-menu" aria-expanded="false">
        <span class="nav-menu-closed"><span class="nav-menu-icon" aria-hidden="true">☰</span> Menu</span>
        <span class="nav-menu-open"><span class="nav-menu-icon" aria-hidden="true">✕</span> Close</span>
      </summary>
    </details>
  </div>
</header>

<!--
  The panel lives OUTSIDE <header> on purpose. .site-header carries backdrop-filter, which creates
  both a backdrop root and a containing block, so glass nested inside it could never sample the page
  behind it and a position:fixed scrim would be sized to the header. As a body-level sibling the
  panel's backdrop-filter reaches the hero and the crystals keep falling behind it.
  It opens from the <details> state via :has(), so the menu works without JavaScript.
-->
<MenuPanel path={path} />
