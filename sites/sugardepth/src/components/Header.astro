---
import { APP_URL } from '../config';
const { path } = Astro.props as { path: string };
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/ingredients', label: 'Ingredients' },
  { href: '/hidden-sugar-names', label: 'Hidden sugar names' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => (href === '/ingredients' ? path.startsWith('/ingredients') : path === href);
---
<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="Sugar Depth home"><span>Sugar Depth</span></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="btn sm primary header-cta" href={APP_URL}><span class="shutter" aria-hidden="true"></span>Scan a label</a>
    <details class="nav-menu">
      <summary class="nav-menu-button">
        <span class="nav-backdrop" aria-hidden="true"></span>
        <span class="nav-menu-closed"><span class="nav-menu-icon" aria-hidden="true">☰</span> Menu</span>
        <span class="nav-menu-open"><span class="nav-menu-icon" aria-hidden="true">✕</span> Close</span>
      </summary>
      <div class="nav-panel">
        <nav aria-label="Main">
          {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
        </nav>
      </div>
    </details>
  </div>
</header>
