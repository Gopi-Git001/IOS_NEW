---
// "background rowds shop v1" — the 21st.dev Gradient Builder recipe (base + noise + grain passes),
// ported to a zero-dependency Astro component. Drop it as the first child of a positioned
// band and it fills it behind the content:
//
//   <section class="swarm-band" style="background:none">
//     <GradientBackground />
//     ...content...
//   </section>
//
// Colors are props so the recipe can be remixed without touching the markup.
// Source recipe: https://21st.dev/community/gradients/editor?from=10bf6028-254c-4b76-9d3c-1a62c0aa09cb
interface Props {
  class?: string;
  /** Top of the diagonal ramp. */
  from?: string;
  /** Mid stop of the diagonal ramp. */
  via?: string;
  /** Bottom of the diagonal ramp. */
  to?: string;
  /** Angle of the diagonal ramp, in degrees. */
  angle?: number;
}

const { class: className = '', from = '#16130E', via = '#372F20', to = '#9C8D63', angle = 170 } = Astro.props;

// The builder's base tile: a 120px fractal-noise SVG multiplied over the ramp at 13% opacity.
const NOISE_TILE =
  "url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.130'/></svg>\")";

// Unique per instance so two gradients on one page don't share a filter id.
const grainId = `grain-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['gradient-bg', className]}
  aria-hidden="true"
  data-from={from}
  data-via={via}
  data-to={to}
  data-angle={angle}
  style={`--gb-from:${from};--gb-via:${via};--gb-to:${to};--gb-angle:${angle}deg;--gb-noise:${NOISE_TILE}`}
>
  <div class="gb-base"></div>
  <svg class="gb-grain" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <filter id={grainId}>
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter={`url(#${grainId})`}></rect>
  </svg>
</div>

<style>
  /* Fills its parent exactly, the way the React version's container-type:size wrapper did. */
  .gradient-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Pass 1: the diagonal ramp with the noise tile multiplied over it. */
  .gb-base {
    position: absolute;
    inset: 0;
    background-color: var(--gb-from);
    background-image: var(--gb-noise), linear-gradient(var(--gb-angle), var(--gb-from) 0%, var(--gb-via) 32%, var(--gb-to) 100%);
    background-size: 120px 120px, auto;
    background-blend-mode: overlay, normal;
  }

  /* Pass 2: the builder's grain overlay, desaturated and blended over the ramp. */
  .gb-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.13;
    mix-blend-mode: overlay;
  }
</style>
