---
// Phone menu panel — a glass dropdown card that hangs under the header, anchored top-right.
// Not a full-screen drawer and not a page: the current page stays visible behind it through
// the glass, and the falling crystals keep running behind it.
//
// Rendered as a body-level sibling of <header> (see Header.astro) so the panel's
// backdrop-filter samples the page rather than the translucent header bar.
//
// Appearance follows the mock exactly; the 21st.dev component's SVG edge refraction is
// layered on top, feature-detected to Chromium only.
import { APP_URL } from '../config';

interface Props {
  path: string;
  /** id the header's Menu button points at with aria-controls. */
  id?: string;
}

const { path, id = 'phone-menu' } = Astro.props;

const ICONS: Record<string, string> = {
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  flask: '<path d="M9 3h6"/><path d="M10 3v6.5L4.5 19a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L14 9.5V3"/>',
  tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/>',
  help: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  camera: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  shutter: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"/>',
};

const GROUPS = [
  {
    label: 'Learn',
    items: [
      { href: '/', label: 'Home', icon: 'home', match: 'exact' },
      { href: '/how-it-works', label: 'How it works', icon: 'book', match: 'exact' },
      { href: '/hidden-sugar-names', label: 'Hidden sugar names', icon: 'tag', match: 'exact' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { href: '/ingredients', label: 'Ingredient guides', icon: 'flask', match: 'prefix' },
      { href: '/faq', label: 'FAQ', icon: 'help', match: 'exact' },
      { href: '/about', label: 'About', icon: 'info', match: 'exact' },
    ],
  },
] as const;

const isCurrent = (href: string, match: string) => (match === 'prefix' ? path.startsWith(href) : path === href);
---

<div class="menu-scrim" data-menu-scrim aria-hidden="true"></div>

<div class="menu-panel" id={id} data-menu-panel role="dialog" aria-modal="false" aria-label="Menu">
  <div class="menu-head">
    <span class="menu-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={ICONS.camera}></svg>
    </span>
    <span class="menu-head-copy">
      <strong>Sugar Depth</strong>
      <small>Food-label scanner</small>
    </span>
  </div>

  <div class="menu-search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" set:html={ICONS.search}></svg>
    <input type="search" data-menu-input aria-label="Find a page" placeholder="Find a page" autocomplete="off" />
    <button type="button" data-menu-clear aria-label="Clear search" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" set:html={ICONS.x}></svg>
    </button>
  </div>

  <div class="menu-list" data-menu-list>
    <div class="menu-highlight" data-menu-highlight aria-hidden="true"></div>
    {GROUPS.map((group, index) => (
      <div class="menu-group" data-menu-group>
        <p class="menu-group-label">{group.label}</p>
        <ul>
          {group.items.map((item) => {
            const current = isCurrent(item.href, item.match);
            return (
              <li>
                <a
                  href={item.href}
                  data-menu-link
                  data-label={item.label}
                  data-selected={current ? 'true' : undefined}
                  aria-current={current ? 'page' : undefined}
                >
                  <span class="menu-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={ICONS[item.icon]}></svg>
                  </span>
                  <span class="menu-label">{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
        {index === 0 && <div class="menu-divider" aria-hidden="true"></div>}
      </div>
    ))}
    <p class="menu-empty" data-menu-empty role="status" hidden>No matching pages.</p>
  </div>

  <a class="menu-scan" href={APP_URL}>
    <span class="menu-scan-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" set:html={ICONS.shutter}></svg>
    </span>
    Scan a label
  </a>

  <p class="menu-note">Not medical advice. No allergen checks.</p>
</div>

<style>
  /* ---------- scrim: covers the page below the header, never the header ---------- */
  .menu-scrim {
    position: fixed;
    inset-inline: 0;
    inset-block-start: var(--header-h);
    inset-block-end: 0;
    z-index: 24;
    display: none;
    background: rgba(20, 15, 8, 0.32);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  /* ---------- the glass card ---------- */
  .menu-panel {
    position: fixed;
    inset-block-start: calc(var(--header-h) + 12px);
    inset-inline-end: 14px;
    z-index: 26;
    display: none;
    flex-direction: column;
    inline-size: 300px;
    max-inline-size: calc(100vw - 28px);
    max-block-size: calc(100svh - var(--header-h) - 24px);
    padding: 12px;
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #fff;
    font-family: 'Manrope Variable', Manrope, ui-sans-serif, system-ui, sans-serif;

    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.14), transparent 44%),
      rgba(26, 22, 16, 0.42);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.45),
      inset 0 -1px 1px rgba(255, 255, 255, 0.18),
      0 28px 50px -18px rgba(0, 0, 0, 0.6);

    transform-origin: top right;
    overflow: hidden;
  }

  .menu-panel [hidden] {
    display: none !important;
  }

  /* ---------- open state (≤767px) ---------- */
  @media (max-width: 767px) {
    body:has(.nav-menu[open]) .menu-scrim,
    body:has(.nav-menu[open]) .menu-panel {
      display: flex;
    }
    body:has(.nav-menu[open]) .menu-scrim {
      display: block;
      animation: menu-scrim-in 260ms var(--ease-out);
    }
    body:has(.nav-menu[open]) .menu-panel {
      animation: menu-in 260ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* Page scroll is locked while the menu is open. */
    body:has(.nav-menu[open]) {
      overflow: hidden;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  @keyframes menu-scrim-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ---------- head row ---------- */
  .menu-head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    padding: 2px 2px 10px;
  }
  .menu-mark {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 34px;
    block-size: 34px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4);
  }
  .menu-mark svg {
    inline-size: 17px;
    block-size: 17px;
    stroke-width: 1.8;
  }
  .menu-head-copy {
    min-inline-size: 0;
  }
  .menu-head-copy strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .menu-head-copy small {
    display: block;
    margin-block-start: 1px;
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.3;
  }

  /* ---------- search ---------- */
  .menu-search {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    margin-block-end: 10px;
    padding-inline: 10px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.1);
  }
  .menu-search > svg {
    flex: none;
    inline-size: 15px;
    block-size: 15px;
    stroke-width: 1.8;
    color: rgba(255, 255, 255, 0.72);
  }
  .menu-search input {
    inline-size: 100%;
    min-inline-size: 0;
    padding: 11px 4px;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    /* 16px stops iOS zooming the viewport on focus. */
    font-size: 16px;
  }
  .menu-search input::placeholder {
    color: rgba(255, 255, 255, 0.62);
    opacity: 1;
  }
  .menu-search input:focus {
    outline: none;
  }
  .menu-search input::-webkit-search-cancel-button {
    display: none;
  }
  .menu-search button {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 36px;
    block-size: 36px;
    margin-inline-end: -6px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: rgba(255, 255, 255, 0.72);
    cursor: pointer;
  }
  .menu-search button svg {
    inline-size: 15px;
    block-size: 15px;
    stroke-width: 1.8;
  }

  /* ---------- list ---------- */
  .menu-list {
    position: relative;
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
  }

  /* ---------- the one sliding highlight pill ----------
     A single element for the whole list rather than a background per row. It is translated to the
     hovered / focused / current row, so the glass highlight glides instead of flicking on and off.
     Rows sit above it (z-index 1); the pill itself is decoration only. */
  .menu-highlight {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 0;
    block-size: 46px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.26),
      rgba(255, 255, 255, 0.08) 55%,
      rgba(255, 255, 255, 0.14)
    );
    -webkit-backdrop-filter: blur(4px) saturate(1.6);
    backdrop-filter: blur(4px) saturate(1.6);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.55),
      inset 0 -1px 1px rgba(255, 255, 255, 0.2),
      inset 0 6px 10px -6px rgba(255, 255, 255, 0.35),
      0 8px 18px -10px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    opacity: 0;
    /* y and height are set from JS; only opacity is a plain CSS transition (reveal/hide). */
    transition: opacity 0.2s linear;
    will-change: transform, height;
  }
  .menu-highlight[data-visible='true'] {
    opacity: 1;
  }
  .menu-group-label {
    position: relative;
    z-index: 1;
    margin: 4px 8px 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }
  .menu-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-group[hidden] {
    display: none;
  }
  .menu-group a {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
    gap: 10px;
    block-size: 46px;
    padding-inline: 10px;
    border-radius: 13px;
    color: #fff;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-group a:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.75);
    outline-offset: -2px;
  }
  /* The current page keeps bold text and the mint dot, but no per-row background — the sliding
     pill is the only highlight now, so it can sit on a different row. */
  .menu-group a[data-selected='true'] {
    font-weight: 700;
  }
  .menu-group a[data-selected='true']::after {
    content: '';
    margin-inline-start: auto;
    flex: none;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: #7ef0b4;
    box-shadow: 0 0 6px rgba(126, 240, 180, 0.55);
  }
  .menu-icon {
    display: grid;
    place-items: center;
    flex: 0 0 18px;
  }
  .menu-icon svg {
    inline-size: 17px;
    block-size: 17px;
    stroke-width: 1.8;
  }
  .menu-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .menu-divider {
    block-size: 1px;
    margin: 8px 6px;
    background: rgba(255, 255, 255, 0.16);
  }
  .menu-empty {
    margin: 0;
    padding: 10px 8px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ---------- scan pill + note ---------- */
  .menu-scan {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    flex: none;
    inline-size: 100%;
    block-size: 52px;
    margin-block-start: 12px;
    border-radius: 999px;
    background: #fff;
    color: #141613;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 10px 24px rgba(0, 0, 0, 0.28);
  }
  .menu-scan:hover {
    background: #fff;
    transform: translateY(-1px);
  }
  .menu-scan:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .menu-scan-icon {
    display: grid;
    place-items: center;
  }
  .menu-scan-icon svg {
    inline-size: 18px;
    block-size: 18px;
    stroke-width: 2;
  }
  .menu-note {
    flex: none;
    margin: 10px 0 2px;
    text-align: center;
    font-size: 11px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ---------- reduced motion: fade only ---------- */
  @media (prefers-reduced-motion: reduce) {
    body:has(.nav-menu[open]) .menu-panel,
    body:has(.nav-menu[open]) .menu-scrim {
      animation: none;
    }
    body:has(.nav-menu[open]) .menu-panel {
      animation: menu-fade 200ms linear;
    }
    .menu-scan {
      transition: none;
    }
    .menu-scan:hover {
      transform: none;
    }
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Safe-area: keep the card clear of the notch/home indicator on tall phones. */
  @supports (padding: env(safe-area-inset-top)) {
    .menu-panel {
      max-block-size: calc(
        100svh - var(--header-h) - 24px - env(safe-area-inset-bottom, 0px)
      );
    }
    .menu-scrim {
      inset-block-end: 0;
    }
  }
</style>

<script is:inline data-motion>
  // Focus management, Escape, outside-tap and search filtering for the phone menu.
  // Open/close itself is CSS-only (body:has(.nav-menu[open])), so the menu still works
  // without this script; everything here is progressive enhancement.
  (function () {
    var toggle = document.querySelector('.nav-menu-button');
    var details = document.querySelector('.nav-menu');
    var panel = document.querySelector('[data-menu-panel]');
    var scrim = document.querySelector('[data-menu-scrim]');
    if (!toggle || !details || !panel) return;

    // Anchor the scrim and panel to the header's measured height: the CSS default (60px) can be
    // off by a fraction from the border/padding, which would show a sliver of page at the seam.
    var header = document.querySelector('.site-header');
    function syncHeaderHeight() {
      if (!header) return;
      var h = Math.round(header.getBoundingClientRect().height);
      if (h > 0) document.documentElement.style.setProperty('--header-h', h + 'px');
    }
    syncHeaderHeight();
    if ('ResizeObserver' in window && header) new ResizeObserver(syncHeaderHeight).observe(header);

    var input = panel.querySelector('[data-menu-input]');
    var clear = panel.querySelector('[data-menu-clear]');
    var empty = panel.querySelector('[data-menu-empty]');
    var groups = [].slice.call(panel.querySelectorAll('[data-menu-group]'));
    var focusables = function () {
      return [].slice
        .call(panel.querySelectorAll('a[href], button:not([hidden]), input'))
        .filter(function (el) {
          return el.offsetParent !== null;
        });
    };

    function syncExpanded() {
      toggle.setAttribute('aria-expanded', details.open ? 'true' : 'false');
    }

    function focusIntoPanel() {
      var first = focusables()[0];
      // The search field is the most useful landing point, but never steal a scroll.
      (input || first) && (input || first).focus({ preventScroll: true });
    }

    function restoreFocus() {
      var burger = document.querySelector('.nav-menu-button');
      if (burger) burger.focus({ preventScroll: true });
    }

    function close() {
      if (!details.open) return;
      details.open = false;
      syncExpanded();
      restoreFocus();
    }

    details.addEventListener('toggle', function () {
      syncExpanded();
      if (details.open) {
        // Wait a frame so the panel is displayed and rows have geometry before focusing / placing.
        requestAnimationFrame(function () {
          focusIntoPanel();
          // First open: drop the pill straight onto the current row (no glide from 0).
          var start = currentLink() || visibleLinks()[0] || null;
          if (start) {
            var m = metrics(start);
            pill.style.transform = 'translateY(' + m.y + 'px)';
            pill.style.blockSize = m.h + 'px';
            pill.dataset.y = String(m.y);
            pill.dataset.h = String(m.h);
            pill.setAttribute('data-visible', 'true');
          }
        });
      }
    });

    // Scrim tap closes.
    if (scrim) {
      scrim.addEventListener('click', close);
    }

    // Escape closes, from anywhere.
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      if (!details.open) return;
      event.preventDefault();
      close();
    });

    // Tapping a link closes the menu (then the browser navigates).
    [].forEach.call(panel.querySelectorAll('[data-menu-link], .menu-scan'), function (a) {
      a.addEventListener('click', function () {
        details.open = false;
        syncExpanded();
      });
    });

    // --- sliding highlight pill ---
    // One pill for the whole list (the recipe's selection marker), gliding to whatever row is
    // hovered, focused or current. Motion uses the Web Animations API rather than GSAP: this site's
    // post-build check allows only data-motion inline scripts, and GSAP's "back.out(1.6)" is just
    // cubic-bezier(0.34, 1.56, 0.64, 1) — the same spring, expressed natively.
    var list = panel.querySelector('[data-menu-list]');
    var pill = panel.querySelector('[data-menu-highlight]');
    var links = [].slice.call(panel.querySelectorAll('[data-menu-link]'));
    // Only visible rows can hold the pill. A filtered-out row is inside a [hidden] <li>.
    function visibleLinks() {
      return links.filter(function (a) {
        return a.offsetParent !== null;
      });
    }
    function currentLink() {
      var cur = links.filter(function (a) {
        return a.getAttribute('aria-current') === 'page' && a.offsetParent !== null;
      });
      return cur[0] || null;
    }

    var pillAnims = { move: null, squeeze: null };
    var EASE = 'cubic-bezier(0.34, 1.56, 0.64, 1)'; // = back.out(1.6)
    var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Row geometry relative to the scrolling list. Uses layout offsets (offsetTop/offsetHeight)
    // rather than getBoundingClientRect: the panel animates scale(0.96 -> 1) on open, and a rect
    // measured mid-animation comes back scaled (26px reads as 24.6px, which misplaces the pill).
    function metrics(link) {
      var y = 0;
      for (var node = link; node && node !== list; node = node.offsetParent) {
        y += node.offsetTop;
      }
      return { y: y, h: link.offsetHeight };
    }

    function movePill(link) {
      if (!pill || !list) return;
      if (!link) {
        pill.setAttribute('data-visible', 'false');
        return;
      }
      var m = metrics(link);
      var prev = parseFloat(pill.dataset.y || 'NaN');
      pill.dataset.y = String(m.y);
      pill.setAttribute('data-visible', 'true');

      if (REDUCED) {
        pill.style.transform = 'translateY(' + m.y + 'px)';
        pill.style.blockSize = m.h + 'px';
        return;
      }

      var jump = isNaN(prev) ? 0 : Math.abs(m.y - prev);
      pillAnims.move && pillAnims.move.cancel();
      pillAnims.move = pill.animate(
        [
          { transform: 'translateY(' + (isNaN(prev) ? m.y : prev) + 'px)', height: (parseFloat(pill.dataset.h || '0') || m.h) + 'px' },
          { transform: 'translateY(' + m.y + 'px)', height: m.h + 'px' },
        ],
        { duration: 420, easing: EASE, fill: 'forwards' }
      );
      pill.dataset.h = String(m.h);

      // A long jump reads as a glide; squeeze horizontally so it feels like it snaps into place.
      if (jump > 60) {
        pillAnims.squeeze && pillAnims.squeeze.cancel();
        pillAnims.squeeze = pill.animate(
          [
            { scale: '1' },
            { scale: '0.96', offset: 0.5 },
            { scale: '1' },
          ],
          { duration: 180, easing: 'ease-out' }
        );
      }
    }

    var pinned = null; // the row the pointer/focus is on, if any
    function restorePill() {
      var target = pinned || currentLink() || visibleLinks()[0] || null;
      movePill(target);
    }

    links.forEach(function (link) {
      link.addEventListener('mouseenter', function () {
        pinned = link;
        movePill(link);
      });
      link.addEventListener('focus', function () {
        pinned = link;
        movePill(link);
      });
      // On tap the tapped row becomes current, then the pill settles on it.
      link.addEventListener('click', function () {
        links.forEach(function (a) {
          a.removeAttribute('aria-current');
          a.removeAttribute('data-selected');
        });
        link.setAttribute('aria-current', 'page');
        link.setAttribute('data-selected', 'true');
        pinned = link;
        movePill(link);
      });
    });
    if (list) {
      list.addEventListener('mouseleave', function () {
        pinned = null;
        restorePill();
      });
      // Scrolling the list past the pill's row would desync; re-measure.
      list.addEventListener('scroll', function () {
        var target = pinned || currentLink();
        if (!target) return;
        var m = metrics(target);
        pill.style.transform = 'translateY(' + m.y + 'px)';
      }, { passive: true });
      // Focusing something outside the rows (search, scan) releases the pill.
      list.addEventListener('focusout', function (event) {
        if (event.relatedTarget && list.contains(event.relatedTarget)) return;
        pinned = null;
        restorePill();
      });
    }

    // --- search filter ---
    function filter(query) {
      var q = query.trim().toLowerCase();
      var matches = 0;
      groups.forEach(function (group) {
        var shown = 0;
        [].forEach.call(group.querySelectorAll('[data-menu-link]'), function (link) {
          var hit = !q || (link.getAttribute('data-label') || '').toLowerCase().indexOf(q) !== -1;
          link.parentElement.hidden = !hit;
          if (hit) shown++;
        });
        group.hidden = shown === 0;
        matches += shown;
      });
      if (empty) empty.hidden = matches !== 0;
      if (clear) clear.hidden = !q;
      // Rows moved: re-measure. No match hides the pill entirely.
      if (!matches) {
        pinned = null;
        movePill(null);
      } else {
        var stillVisible = pinned && pinned.offsetParent !== null;
        if (!stillVisible) pinned = null;
        restorePill();
      }
    }

    if (input) {
      input.addEventListener('input', function () {
        filter(input.value);
      });
      input.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape' || !input.value) return;
        event.preventDefault();
        event.stopPropagation();
        input.value = '';
        filter('');
      });
    }
    if (clear) {
      clear.addEventListener('click', function () {
        input.value = '';
        filter('');
        input.focus();
      });
    }

    syncExpanded();
  })();
</script>
