---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Sources from '../components/Sources.astro';
import ScanCta from '../components/ScanCta.astro';
import EditorialImage from '../components/EditorialImage.astro';
import Film from '../components/Film.astro';
import FilmMotion from '../components/FilmMotion.astro';
import { RULES, TREATMENT_ROWS } from '../data/rules';
import { MAX_OKAY_ADDED_G, pageById, toneClass, type IngredientPage } from '../data/ingredients';
import { S } from '../data/sources';
import { PRE_V3_MEDIA_NOTE } from '../data/media';
import { breadcrumbs, ORG_ID } from '../data/schema';
import { POLICY_VERSION, REGISTRY_VERSION, CONTENT_UPDATED, abs } from '../config';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'How it works', href: '/how-it-works' }];
const G = MAX_OKAY_ADDED_G;
// The identity table: each row is read from the registry, and its entries must agree with each other.
const one = (values: string[], what: string, row: string[]) => {
  if (new Set(values).size !== 1) throw new Error(`how-it-works: ${row.join(', ')} do not share one ${what}`);
  return values[0];
};
const treatments = TREATMENT_ROWS.map((row) => {
  const pages = row.map((id) => {
    const page = pageById(id);
    if (!page) throw new Error(`how-it-works: "${id}" is not in the ingredient registry`);
    return page;
  });
  const source = pages[0].sources.find((k) => k !== 'addedSugarsRule' && k !== 'euAdditives') as keyof typeof S | undefined;
  return {
    pages,
    cls: one(pages.map((x: IngredientPage) => x.classLabel), 'class', row),
    labeling: one(pages.map((x: IngredientPage) => x.labelingLabel), 'label treatment', row),
    verdict: one(pages.map((x: IngredientPage) => x.verdict.label), 'verdict', row),
    tone: toneClass(pages[0].verdict.tone),
    source,
  };
});
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How Sugar Depth verdicts work: the full rule table',
  description: 'The ordered rules Sugar Depth uses to call a food label CLEAN, OKAY or BAD.',
  url: abs('/how-it-works'),
  mainEntityOfPage: abs('/how-it-works'),
  dateModified: CONTENT_UPDATED,
  datePublished: CONTENT_UPDATED,
  image: abs('/og/default.png'),
  author: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
};
---
<Base
  title="How Sugar Depth verdicts work: the full CLEAN, OKAY, BAD rule table"
  description={`The ordered rules behind every Sugar Depth verdict: more than ${G} g of added sugar per serving, an artificial sweetener or alcohol is BAD; less added sugar, a sugar alcohol, stevia or monk fruit is OKAY; nothing sweet added is CLEAN.`}
  path="/how-it-works"
  jsonLd={[article, breadcrumbs(crumbs)]}
>
  <div class="wrap page-head editorial-article">
    <Breadcrumbs items={crumbs} />
    <span class="kicker">The rulebook · {POLICY_VERSION}</span>
    <h1>How verdicts work</h1>
    <p class="lead">
      Sugar Depth gives a food label one of three verdicts. <strong class="ugly">BAD</strong> means more than {G}&nbsp;g of
      added sugar per serving (or added sugar whose grams can't be read), any artificial sweetener, or drinking alcohol.{" "}
      <strong class="bad">OKAY</strong> means no BAD trigger, but added sugar at {G}&nbsp;g or less per serving, a sugar alcohol,
      allulose, stevia, monk fruit or thaumatin.{" "}
      <strong class="clean">CLEAN</strong> means a complete ingredient list with nothing sweet added.
    </p>
    <p class="voice">Three verdicts. The worst ingredient decides.</p>
    <figure class="editorial-frame label-figure">
      <EditorialImage name="label" alt="A thick clear glass slab rests over fine print on a cream food package, with a sugar cube beside it." />
    </figure>
  </div>

  <div class="wrap page-body editorial-article">
    <div class="prose">
      <h2 id="pipeline">What happens to your photo</h2>
      <ol>
        <li><strong>Reading.</strong> An AI vision model (Anthropic's Claude) copies the ingredient list and the printed sugar numbers exactly as they appear. It doesn't sort anything or give a verdict.</li>
        <li><strong>Cleaning up.</strong> The text is split into ingredients, including ones nested in brackets, "and/or" choices, lead-ins like "Contains 2% or less of", footnote marks and E or INS codes.</li>
        <li><strong>Matching.</strong> Each ingredient is matched to one versioned registry ({REGISTRY_VERSION}) by its exact name, never by a fragment. "Sugar" never matches "sugar alcohol", and "maltodextrin" never matches "resistant maltodextrin".</li>
        <li><strong>Deciding.</strong> The ordered rules below produce the verdict, the rule that fired, and the printed words that triggered it.</li>
      </ol>
      <figure class="editorial-frame steps-film">
        <Film name="three-steps" label="Three illustrated stages: photograph the label, read the ingredient names, and reveal one verdict." width={1280} height={720}>
          <EditorialImage name="label" alt="Clear glass magnifies the ingredient print on a cream package beside a sugar cube." sizes="(max-width: 760px) calc(100vw - 40px), 800px" />
        </Film>
        <figcaption>{PRE_V3_MEDIA_NOTE}</figcaption>
      </figure>
      <p>
        A separate verdict checker also looks at the photo. The verdict shown is the stricter of its call and the rules
        below: the checker can raise a verdict, but it can't lower one. The rules alone decide when the checker is
        unavailable or unsure.
      </p>
    </div>

    <h2 id="rules" style="margin-top:56px">The rule table</h2>
    <p class="muted prose">Rules are checked from top to bottom. The first one that matches decides.</p>
    <div class="table-wrap">
      <table class="facts-table" role="table">
        <caption>Sugar Depth {POLICY_VERSION}. First match wins.</caption>
        <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader" id="rule-col-rule">Rule</th><th scope="col" role="columnheader" id="rule-col-when">When</th><th scope="col" role="columnheader" id="rule-col-result">Result</th></tr></thead>
        <tbody role="rowgroup">
          {RULES.map((r) => (
            <tr id={`rule-${r.id}`} role="row">
              <td class="rid" role="cell" headers="rule-col-rule"><span class="table-label" aria-hidden="true">Rule</span>{r.id}</td>
              <td role="cell" headers="rule-col-when"><span class="table-label" aria-hidden="true">When</span>{r.condition}</td>
              <td class={`out ${r.outcome} ${toneClass(r.outcome)}`} role="cell" headers="rule-col-result"><span class="table-label" aria-hidden="true">Result</span>{r.result}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose">
      <h3>Why BAD and OKAY are checked before a cut-off list</h3>
      <p>A cut-off list can only hide more ingredients, never fewer. So if the visible part already lists added sugar, a sweetener or alcohol, that decides the verdict (BAD or OKAY) even though the rest is missing. If nothing like that is visible and the list is cut off, Sugar Depth asks for a retake instead of guessing CLEAN.</p>
      <h3>Blends and the worst ingredient</h3>
      <p>Every ingredient inside a blend is checked, so "sweetener blend (sucralose, stevia leaf extract)" is BAD because of the sucralose. Stevia never overrides a worse ingredient.</p>
      <h3>What the rules don't do</h3>
      <p>The rules make no guesses from an ingredient's position in the list or a brand's intent. Sugar listed last counts the same as sugar listed first. The only amount that matters is the added sugar per serving printed on the Nutrition Facts panel.</p>
    </div>

    <h2 id="identity" style="margin-top:56px">Identity vs. treatment</h2>
    <p class="muted prose">What an ingredient is, how US labels count it, and how Sugar Depth treats it are three separate questions. Some examples:</p>
    <div class="table-wrap">
      <table class="facts-table" role="table">
        <caption>Identity, US label treatment and Sugar Depth verdict</caption>
        <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader" id="identity-col-ingredient">Ingredient</th><th scope="col" role="columnheader" id="identity-col-class">What it is</th><th scope="col" role="columnheader" id="identity-col-label">US label treatment</th><th scope="col" role="columnheader" id="identity-col-verdict">Sugar Depth</th></tr></thead>
        <tbody role="rowgroup">
          {treatments.map((t) => (
            <tr role="row">
              <td class="rid ingr" role="cell" headers="identity-col-ingredient"><span class="table-label" aria-hidden="true">Ingredient</span><strong>{t.pages.map((x, i) => <>{i > 0 && ', '}<a href={`/ingredients/${x.slug}`}>{i > 0 ? x.name.toLowerCase() : x.name}</a></>)}</strong></td>
              <td role="cell" headers="identity-col-class"><span class="table-label" aria-hidden="true">What it is</span>{t.cls}</td>
              <td role="cell" headers="identity-col-label"><span class="table-label" aria-hidden="true">US label treatment</span>{t.source ? <a href={S[t.source].url}>{t.labeling}</a> : t.labeling}</td>
              <td class={`out ${t.tone}`} role="cell" headers="identity-col-verdict"><span class="table-label" aria-hidden="true">Sugar Depth</span>{t.verdict}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose">
      <h2 id="quantities">Quantities</h2>
      <ul>
        <li>Total Sugars and Added Sugars are kept separate, along with their basis: per serving, per 100&nbsp;g, per 100&nbsp;ml, or unknown.</li>
        <li>Missing grams stay missing. They are never turned into 0.</li>
        <li>Added sugar per serving is the one number that changes a verdict: more than {G}&nbsp;g is BAD, {G}&nbsp;g or less is OKAY. A panel that doesn't say what its numbers are per is read as per serving.</li>
        <li>When added sugar is listed but the grams per serving can't be read, or are printed only per 100&nbsp;g or 100&nbsp;ml, the label is BAD.</li>
        <li>A printed <strong>0&nbsp;g</strong> doesn't cancel a listed added sugar: the label is OKAY, not CLEAN. US labels may round amounts under 0.5&nbsp;g down to zero (<a href={S.nutritionLabel.url}>21 CFR 101.9</a>), and the result says so.</li>
        <li>If the panel shows added sugar but none was found in a complete ingredient list, the panel grams decide and the contradiction is reported.</li>
      </ul>

      <h2 id="limits">Limits</h2>
      <ul>
        <li><strong>Not medical advice.</strong> The verdicts are Sugar Depth's preferences about added sugars and sweeteners. They are not safety findings, and they are not a diet plan.</li>
        <li><strong>No allergen checks.</strong> Always read the label yourself for allergens.</li>
        <li><strong>Only what's printed.</strong> Sugar Depth reads the label in the photo. It has no product database, so it can't know about a recipe change the label doesn't show.</li>
        <li><strong>Unreadable means retake.</strong> A blurry, glare-covered or cut-off list gets a request to retake the photo, not a guess.</li>
        <li><strong>Unknown names.</strong> An unrecognized ingredient that sounds sweet (or an unknown sweetener code from E950 to E969) makes a label OKAY instead of CLEAN, and so do two or more ingredients the registry doesn't know. One unrecognized ingredient with no sweet signal doesn't block CLEAN.</li>
        <li><strong>Juice depends on the product.</strong> <a href="/ingredients/juice-concentrate">Juice concentrate</a>, <a href="/ingredients/juice-from-concentrate">juice from concentrate</a> and <a href="/ingredients/fruit-puree-concentrate">fruit puree concentrate</a> count as added sugar when they sweeten another food, and as natural sugar in a product made only of fruit or juice.</li>
        <li><strong>Strict mode.</strong> Strict mode is on by default. With it off in the scanner's menu, a product whose only sweetener is stevia, monk fruit or thaumatin shows as CLEAN. It never turns added sugar, an artificial sweetener or alcohol into CLEAN.</li>
        <li><strong>US labels first.</strong> Label treatment notes follow US FDA rules. E numbers are recognized, but other countries' labeling rules aren't described here.</li>
      </ul>
      <p>Browse the <a href="/ingredients">ingredient guides</a> or the full list of <a href="/hidden-sugar-names">hidden sugar names</a>.</p>
      <Sources keys={['addedSugarsRule', 'addedSugarsQA', 'allulose', 'rareSugars', 'maltodextrin', 'fiber', 'nutritionLabel', 'sweeteners']} />
    </div>
    <div style="margin-top:48px"><ScanCta /></div>
  </div>
  <FilmMotion />
</Base>
