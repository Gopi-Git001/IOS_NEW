---
import Base from '../layouts/Base.astro';
import CrystalVerdict from '../components/CrystalVerdict.astro';
import TryIt from '../components/TryIt.astro';
import CrystalSwarm from '../components/CrystalSwarm.astro';
import { APP_URL } from '../config';
import { organization, website, webApplication } from '../data/schema';
import { MISSION, MISSION_DETAIL } from '../data/mission';
import { VERDICTS } from '../data/rules';
import { ADDED_SUGAR_ALIAS_COUNT, PAGES, toneClass } from '../data/ingredients';
// After Base and the components, so these rules come last in the page's CSS.
import '../styles/brief-pages.css';

// Three sections: the mission, how it works, and everything else.

// Alias tiles: a name as a label prints it on the front, "That's sugar." on the back. Every name is read from the
// scanner's registry (src/data/ingredients.ts) and must be one it files under added sugar.
const TILE_ALIASES = ['evaporated cane juice', 'brown rice syrup', 'agave nectar', 'dextrose', 'barley malt syrup', 'fruit juice concentrate', 'coconut sugar', 'invert sugar'];
const addedSugarNames = new Set(PAGES.filter((p) => p.treatment === 'added_sugar').flatMap((p) => p.aliases));
const tiles = TILE_ALIASES.map((alias) => {
  if (!addedSugarNames.has(alias)) throw new Error(`index: "${alias}" is not an added-sugar name in the ingredient registry`);
  return alias[0].toUpperCase() + alias.slice(1);
});

const explore = [
  { href: '/hidden-sugar-names', label: `All ${ADDED_SUGAR_ALIAS_COUNT} added-sugar names` },
  { href: '/ingredients', label: 'Ingredient guides' },
  { href: '/how-it-works', label: 'The full rules' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];
---
<Base
  title="Sugar Depth: the food-label scanner that names every hidden sugar"
  description="Sugar Depth is a food-label scanner. Photograph an ingredient list and get one verdict: CLEAN, OKAY or BAD. No barcodes, no product database."
  path="/"
  jsonLd={[organization, website, webApplication]}
>
  <section class="hero swarm-band" data-swarm="hero" aria-labelledby="mission-h">
    <CrystalSwarm />
    <div class="wrap hero-split">
      <div class="hero-copy" data-swarm-copy>
        <span class="kicker">Our mission</span>
        <h1 id="mission-h">{MISSION}</h1>
        <p class="lead">{MISSION_DETAIL}</p>
        <div class="cta-row" data-sticky-hide>
          <a class="btn primary" href={APP_URL}><span class="shutter" aria-hidden="true"></span>Scan a label</a>
        </div>
        <p class="plain-note">A food-label scanner. Not medical advice; no allergen checks.</p>
      </div>
      <CrystalVerdict interactive compact rotate verdict="CLEAN" />
    </div>
  </section>

  <section class="how" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How it works</h2>
      <ol class="how-steps">
        <li>
          <span class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 16v-4a4 4 0 0 1 4-4h4M32 8h4a4 4 0 0 1 4 4v4M40 32v4a4 4 0 0 1-4 4h-4M16 40h-4a4 4 0 0 1-4-4v-4" />
              <path d="M16 19h16M16 24h11M16 29h14" />
            </svg>
          </span>
          <span>Snap the ingredient list.</span>
        </li>
        <li>
          <span class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 12h22M8 20h11M8 28h8M8 36h12" />
              <circle cx="30" cy="27" r="8" />
              <path d="M36 33l6 6" />
            </svg>
          </span>
          <span>We check every name.</span>
        </li>
        <li>
          <span class="how-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="10" y="6" width="28" height="36" rx="7" />
              <path d="M17 14h7" />
              <path d="M17.5 32h13" stroke-width="5.5" />
            </svg>
          </span>
          <span>Get one word: CLEAN, OKAY or BAD.</span>
        </li>
      </ol>

      <ul class="how-verdicts">
        {VERDICTS.map((v) => (
          <li class={`how-verdict tone-${toneClass(v.word)}`}>
            <h3><span class="how-chip" aria-hidden="true"></span>{v.word}</h3>
            <p>{v.line}</p>
            <details class="verdict-more">
              <summary>The {v.word} rules</summary>
              <ul>{v.rules.map((r) => <li>{r}</li>)}</ul>
            </details>
          </li>
        ))}
      </ul>

      <TryIt />
    </div>
  </section>

  <section class="aliases explore swarm-band" aria-labelledby="explore-h">
    <div class="wrap disguise-grid">
      <div class="section-head" data-burst-clear>
        <h2 id="explore-h">Explore</h2>
        <p class="flip-hint">Eight of sugar's aliases. Tap a card to unmask it.</p>
      </div>
      <!-- Each tile is a button: a click, a tap, Enter or Space turns it over and back (src/lib/swarm.ts). Without
           the script nothing turns: every tile shows its name and the answer together. -->
      <div class="tiles-stage" data-tiles>
        <canvas class="tiles-fx" data-tiles-fx aria-hidden="true"></canvas>
        <ul class="tiles">
          {tiles.map((alias) => (
            <li>
              <button class="tile" type="button" aria-pressed="false">
                <span class="tile-face tile-front"><span class="tile-alias">{alias}</span></span>
                <span class="tile-face tile-back"><span class="tile-tag">Added sugar</span><span class="tile-reveal">That's sugar.</span></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <p class="sr-only" role="status" data-tiles-status></p>
      <div class="explore-more" data-burst-clear>
        <ul class="explore-links">
          {explore.map((l) => <li><a href={l.href}>{l.label}<span aria-hidden="true">→</span></a></li>)}
        </ul>
        <p class="explore-cta" data-sticky-hide>
          <a class="btn primary" href={APP_URL}><span class="shutter" aria-hidden="true"></span>Scan a label</a>
        </p>
      </div>
    </div>
  </section>
</Base>
