---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ScanCta from '../../components/ScanCta.astro';
import { breadcrumbs } from '../../data/schema';
const guides = (await getCollection('ingredients')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Ingredients', href: '/ingredients' }];
const groups = [
  { v: 'UGLY', title: 'UGLY: added sugars, artificial sweeteners, erythritol, xylitol' },
  { v: 'BAD', title: 'BAD: plant sweeteners and allulose' },
  { v: 'CLEAN', title: 'Allowed in CLEAN: sounds sweet, isn\'t' },
];
---
<Base
  title="Sweetener and sugar ingredient guides"
  description="Plain-language guides to sucralose, aspartame, acesulfame K, erythritol, xylitol, stevia, monk fruit, allulose, maltodextrin, juice concentrate and evaporated cane juice: label names, US labeling and Sugar Depth's verdict."
  path="/ingredients"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <div class="wrap page-head">
    <Breadcrumbs items={crumbs} />
    <span class="kicker">Ingredient guides</span>
    <h1>Every sweetener has a stage name.</h1>
    <p class="lead">These guides explain the sweet-sounding ingredients Sugar Depth looks for: what each one is, the names it uses on labels, how US labels count it, and the verdict it gets. Each guide cites FDA or federal regulations.</p>
  </div>
  <div class="wrap page-body">
    {groups.map((g) => (
      <section style="padding:12px 0 36px" aria-labelledby={`g-${g.v}`}>
        <h2 id={`g-${g.v}`} style="font-size:1.4rem"><span class={g.v.toLowerCase()}>{g.title.split(':')[0]}</span>:{g.title.split(':')[1]}</h2>
        <ul class="cards">
          {guides.filter((x) => x.data.verdict === g.v).map((x) => (
            <li><a class="sheet card" href={`/ingredients/${x.id}`}>
              <span class={`pill ${x.data.verdict.toLowerCase()}`}>{x.data.verdictLabel ?? x.data.verdict}</span>
              <h3>{x.data.name}</h3>
              <p>{x.data.summary}</p>
            </a></li>
          ))}
        </ul>
      </section>
    ))}
    <p class="muted">Looking for honey, agave, dextrose or rice syrup? They're all added sugar: see the <a href="/hidden-sugar-names">hidden sugar names</a>. The complete rules are on <a href="/how-it-works">how it works</a>.</p>
    <div style="margin-top:40px"><ScanCta /></div>
  </div>
</Base>
