---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ScanCta from '../../components/ScanCta.astro';
import { breadcrumbs } from '../../data/schema';
import { getGuides } from '../../data/guides';
import { GROUPS, toneClass } from '../../data/ingredients';
import '../../styles/brief.css';
// A directory to scan, not to read: each card is a name, its verdict and a few words.
const guides = await getGuides();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Ingredients', href: '/ingredients' }];
---
<Base
  title="Ingredient guides: every sugar, sweetener and label name Sugar Depth knows"
  description={`All ${guides.length} ingredients Sugar Depth knows, from added sugars to artificial sweeteners and sugar alcohols, each with its label names and verdict.`}
  path="/ingredients"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <div class="wrap page-head">
    <Breadcrumbs items={crumbs} />
    <span class="kicker">Ingredient guides</span>
    <h1>Every sweetener has a stage name.</h1>
    <p class="lead">{guides.length} ingredients, each with its label names and its verdict.</p>
    <nav class="brief-jump" aria-label="Jump to a group">
      <ul class="alias-list">
        {GROUPS.map((g) => <li><a href={`#g-${g.id}`}>{g.nav}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap page-body">
    {GROUPS.map((g) => {
      const [head, ...rest] = g.title.split(':');
      const items = guides.filter((x) => x.page.group === g.id);
      return (
        <section class="brief-group" aria-labelledby={`g-${g.id}`}>
          <h2 id={`g-${g.id}`}><span class={toneClass(g.tone)}>{head}</span>{rest.length > 0 && `:${rest.join(':')}`}</h2>
          <p class="muted">{g.blurb}</p>
          <ul class="brief-dir">
            {items.map((x) => (
              <li><a href={`/ingredients/${x.slug}`}>
                <h3>{x.name}</h3>
                <span class={`pill ${toneClass(x.page.verdict.tone)}`}>{x.page.verdict.word}</span>
                <span class="brief-tag">{x.tag}</span>
              </a></li>
            ))}
          </ul>
        </section>
      );
    })}
    <p class="muted">Every added-sugar name on one page: <a href="/hidden-sugar-names">hidden sugar names</a>. The rules: <a href="/how-it-works">how it works</a>.</p>
    <div style="margin-top:40px"><ScanCta /></div>
  </div>
</Base>
