---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Sources from '../components/Sources.astro';
import ScanCta from '../components/ScanCta.astro';
import EditorialImage from '../components/EditorialImage.astro';
import Film from '../components/Film.astro';
import FilmMotion from '../components/FilmMotion.astro';
import { ADDED_SUGARS } from '../data/sugars';
import { ADDED_SUGAR_ALIAS_COUNT, MAX_OKAY_ADDED_G, POLICY_VERSION, REGISTRY_VERSION } from '../data/ingredients';
import { getGuides } from '../data/guides';
import { breadcrumbs } from '../data/schema';
import '../styles/brief.css';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Hidden sugar names', href: '/hidden-sugar-names' }];
// Hand-written guides about one name in a group (evaporated cane juice under sugar): that name's chip links to it.
const nameGuides = new Map((await getGuides()).filter((g) => g.aliasGuide).map((g) => [`${g.page.id}:${g.name.toLowerCase()}`, g.slug]));
// Every name is in the HTML. A long group shows its first names and keeps the rest in a native <details>.
const SHOWN = 12;
---
<Base
  title={`${ADDED_SUGAR_ALIAS_COUNT} hidden names for added sugar on food labels`}
  description={`The ${ADDED_SUGAR_ALIAS_COUNT} names for added sugar on ingredient lists, from evaporated cane juice and dextrose to brown rice syrup. Every one counts as added sugar.`}
  path="/hidden-sugar-names"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <div class="wrap page-head editorial-article brief-hero">
    <div>
      <Breadcrumbs items={crumbs} />
      <span class="kicker">Name the disguise</span>
      <h1>Hidden sugar names</h1>
      <p class="lead">The {ADDED_SUGAR_ALIAS_COUNT} names Sugar Depth reads as added sugar on an ingredient list.</p>
      <p class="brief-rule">More than {MAX_OKAY_ADDED_G} g of added sugar per serving, or grams that can't be read, is <strong class="ugly">BAD</strong>. {MAX_OKAY_ADDED_G} g or less is <strong class="bad">OKAY</strong>.</p>
      <nav class="brief-jump" aria-label="Jump to a group">
        <ul class="alias-list">
          {ADDED_SUGARS.map((g) => <li><a href={`#${g.page.slug}`}>{g.page.name}</a></li>)}
        </ul>
      </nav>
    </div>
    <figure class="editorial-frame aliases-film">
      <Film name="aliases" label="Six names, including evaporated cane juice and brown rice syrup, are each revealed as sugar." width={1080} height={1080}>
        <EditorialImage name="aliases" alt="Six glass trays hold sugar cubes, golden syrup, brown sugar, pale agave syrup, dark malt syrup and white powder." sizes="(max-width: 760px) calc(100vw - 40px), 560px" />
      </Film>
    </figure>
  </div>
  <div class="wrap page-body editorial-article">
    <div class="brief-names">
      {ADDED_SUGARS.map((g) => {
        const chip = (a: string) => {
          const slug = nameGuides.get(`${g.page.id}:${a}`);
          return <li>{slug ? <a href={`/ingredients/${slug}`}>{a}</a> : a}</li>;
        };
        const n = g.page.aliases.length;
        return (
          <section id={g.page.slug} aria-labelledby={`${g.page.slug}-h`}>
            <h2 id={`${g.page.slug}-h`}><a href={`/ingredients/${g.page.slug}`}>{g.heading}</a></h2>
            <p class="brief-blurb">{g.blurb ?? g.page.note}</p>
            <ul class="alias-list">{g.page.aliases.slice(0, SHOWN).map(chip)}</ul>
            {n > SHOWN && (
              <details class="brief-more">
                <summary>All {n} names</summary>
                <ul class="alias-list">{g.page.aliases.slice(SHOWN).map(chip)}</ul>
              </details>
            )}
            {g.page.patterns.length > 0 && <p class="brief-line">Also any {g.page.patterns.map((p, i) => <>{i > 0 && ' or '}"{p.pattern}"</>)}.</p>}
          </section>
        );
      })}
    </div>
    <div class="prose brief-not">
      <h2>Not on this list</h2>
      <ul>
        <li>Sugar that comes with whole foods, like <a href="/ingredients/milk">milk</a>, <a href="/ingredients/fruit">fruit</a> and <a href="/ingredients/fruit-or-vegetable-juice">single-strength juice</a>. Allowed in CLEAN.</li>
        <li><a href="/ingredients/juice-from-concentrate">Juice from concentrate</a> and <a href="/ingredients/fruit-puree-concentrate">fruit puree concentrate</a>. Added sugar only when they sweeten another food.</li>
        <li>Sweeteners that aren't sugar. <a href="/ingredients/sucralose">Sucralose</a> is BAD. <a href="/ingredients/erythritol">Erythritol</a> and <a href="/ingredients/stevia">stevia</a> are OKAY.</li>
        <li><a href="/ingredients/maltodextrin">Maltodextrin</a>, a nonsweet starch polymer.</li>
      </ul>
      <Sources keys={['addedSugarsRule', 'addedSugarsQA', 'ecj', 'rareSugars']} collapsed>
        <p class="brief-line">From the Sugar Depth ingredient registry {REGISTRY_VERSION} and {POLICY_VERSION}. Names are matched exactly as whole ingredients. The <a href="/how-it-works">full rules</a>.</p>
      </Sources>
    </div>
    <div style="margin-top:48px"><ScanCta /></div>
  </div>
  <FilmMotion />
</Base>
