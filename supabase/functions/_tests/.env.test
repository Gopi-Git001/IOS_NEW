# Secrets for `supabase functions serve` during the Edge Function tests (local stack only).
# No real keys: Claude is the fake server in scan-label.test.ts, and Jev has no key so it reports
# "unavailable" without any network call.
ANTHROPIC_API_KEY=test-key-not-real
ANTHROPIC_BASE_URL=http://host.docker.internal:54399
CLAUDE_MODEL=test-model
SCAN_DAILY_LIMIT=1000
GUEST_SIGNIN=on
GUEST_HOURLY_LIMIT=1000
GUEST_IP_HOURLY_LIMIT=1000
GUEST_IP_SALT=local-fixture-not-a-production-secret
