# Copy to supabase/functions/.env (git-ignored), fill in, then run:
#   npx supabase secrets set --env-file supabase/functions/.env
# These stay on Supabase's servers. Never put them in the app's .env or in any source file.
ANTHROPIC_API_KEY=sk-ant-...
TYPESAFE_API_KEY=...
# Optional
# CLAUDE_MODEL=claude-opus-5-5
# SCAN_DAILY_LIMIT=100          # scans per account per day, per function
# GUEST_SIGNIN=on               # testing builds only; leave unset in production
# GUEST_HOURLY_LIMIT=20         # new guest accounts per hour, across everyone
# ALLOWED_ORIGINS=https://app.sugardepth.com,https://quickgob-web.vercel.app,http://localhost:8081
