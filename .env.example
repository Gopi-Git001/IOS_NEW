# Copy this file to .env and fill in from Supabase: Project Settings > API Keys.
# Both values are public by design (safe to ship in the app). Never put a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional web-only visitor trial. Also requires server rollout settings in docs/guest-scans.md.
EXPO_PUBLIC_GUEST_SCANS=0

# App links: tapping "Scan a label" on sugardepth.com opens the installed app's scan screen.
# These are IDs, not secrets, and they are only needed for a store build; leave them empty and the
# app-link association files are not generated, so every Scan link simply opens the web scanner.
# See docs/app-links.md for where each value comes from.
# Apple Developer > Membership > Team ID (10 characters).
APPLE_TEAM_ID=
# Must match ios.bundleIdentifier in app.json.
IOS_BUNDLE_ID=
# Must match android.package in app.json.
ANDROID_PACKAGE=
# SHA-256 signing-certificate fingerprints, comma separated. Include BOTH the Play App Signing
# fingerprint and the EAS/upload key fingerprint, or App Links break after the first Play upload.
ANDROID_SHA256_CERT_FINGERPRINTS=
